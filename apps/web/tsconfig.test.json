{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "node"
    ],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": []
}
