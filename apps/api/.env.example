# ─── Banco ────────────────────────────────────────────────────────────────────
# Em produção com docker-compose.prod.yml o host é o nome do serviço: postgres
DATABASE_URL="postgresql://prodelphus:TROQUE_ESTA_SENHA@localhost:5433/prodelphusplus?schema=public"

# ─── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origem exata do front. Em produção: https://seu-dominio.com.br
CORS_ORIGIN=http://localhost:5173
# Quantos proxies à frente da API são confiáveis. 0 em dev, 1 atrás do nginx.
TRUST_PROXY=0

# ─── Segredos JWT ─────────────────────────────────────────────────────────────
# Em produção precisam ter 32+ caracteres e não podem conter palavras de exemplo.
# Gere cada um com:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-apenas-troque-em-producao
JWT_REFRESH_SECRET=dev-apenas-troque-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Arquivos ─────────────────────────────────────────────────────────────────
# PDFs de orçamento, invoices, fotos de produto e assinaturas.
# Em produção isto precisa ser um volume com backup — ver scripts/backup.sh
UPLOADS_DIR=./uploads

# ─── Primeiro admin (usado só pelo `npm run prisma:seed`) ─────────────────────
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@prodelphus.com.br
# Obrigatória, mínimo 10 caracteres. Não tem valor padrão de propósito.
ADMIN_SEED_PASSWORD=
