# ─── Banco ────────────────────────────────────────────────────────────────────
# Em produção com docker-compose.prod.yml o host é o nome do serviço: postgres
DATABASE_URL="postgresql://prodelphus:TROQUE_ESTA_SENHA@localhost:5433/prodelphusplus?schema=public"

# ─── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origem exata do front, tal como o navegador enxerga. Em produção isto vem
# de PUBLIC_URL em .env.prod (HTTPS com certificado local — ver README,
# "HTTPS com certificado local"), não é definido diretamente aqui.
CORS_ORIGIN=http://localhost:5173
# Quantos proxies à frente da API são confiáveis. 0 em dev, 1 atrás do nginx.
TRUST_PROXY=0

# ─── Segredos JWT ─────────────────────────────────────────────────────────────
# Em produção precisam ter 32+ caracteres e não podem conter palavras de exemplo.
# Gere cada um com:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-apenas-troque-em-producao
JWT_REFRESH_SECRET=dev-apenas-troque-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Arquivos ─────────────────────────────────────────────────────────────────
# PDFs de orçamento, invoices, fotos de produto e assinaturas.
# Em produção isto precisa ser um volume com backup — ver scripts/backup.sh
UPLOADS_DIR=./uploads

# ─── Numeração de pedidos ─────────────────────────────────────────────────────
# Piso do número do próximo pedido: o próximo é sempre o maior entre "último
# existente + 1" e este valor — pode ser mudado a qualquer momento, mesmo com
# pedidos já criados.
ORDER_NUMBER_START=0
# Mesma regra de piso, mas pro "ID da pasta do cliente" — contador à parte,
# só de pedido internacional.
CLIENT_FOLDER_ID_START=1

# ─── Primeiro admin (usado só pelo `npm run prisma:seed`) ─────────────────────
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@prodelphus.com.br
# Obrigatória, mínimo 6 caracteres. Não tem valor padrão de propósito.
ADMIN_SEED_PASSWORD=

# ─── Google AI Studio ──────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Modelo do Gemini usado pelo Neo. Padrão: gemini-3.5-flash-lite — a cota
# gratuita é por modelo, e a do gemini-3.6-flash (20 requisições/dia no
# projeto inteiro) não sustenta nem os testes. Cada pergunta do Neo gasta de
# 1 a 5 requisições.
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Groq (ditado por voz do Neo) ───────────────────────────────────────────────
# Chave grátis em https://console.groq.com — free tier próprio (2000
# requisições/dia), não consome a cota do Gemini acima. Opcional: sem ela, o
# botão de microfone continua aparecendo, só a transcrição falha com aviso.
GROQ_API_KEY=
