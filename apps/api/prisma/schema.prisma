// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientPrefix {
  NONE
  MR
  MS
}

enum MediaType {
  IMAGE
  DOCUMENT
}

enum QuoteLanguage {
  PT
  EN
  ES
}

enum ProductKind {
  COMPLETE_MODEL
  COMPONENT
}

enum PriceTier {
  FINAL
  DISTRIBUTOR
}

enum Currency {
  BRL
  USD
  EUR
}

enum PrepaymentMethod {
  PAYPAL
  WIRE_TRANSFER
}

enum ClientKind {
  INDIVIDUAL
  INSTITUTION
  DISTRIBUTOR
}

enum OrderStatus {
  PENDING
  COMPLETED
}

model Sector {
  id        String   @id @default(uuid())
  name      String   @unique
  namePt    String?
  createdAt DateTime @default(now())

  @@map("sectors")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(PENDING)
  active       Boolean       @default(true)
  phone        String?
  jobTitle     String?
  signatureUrl String?
  catalogLanguage String     @default("EN")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  productUpdates       Product[]             @relation("ProductUpdatedBy")
  clients              Client[]              @relation("ClientCreatedBy")
  quotes               Quote[]               @relation("QuoteCreatedBy")
  orders               Order[]               @relation("OrderCreatedBy")
  personalTasks        PersonalTask[]        @relation("PersonalTaskOwner")
  personalBoardColumns PersonalBoardColumn[] @relation("PersonalBoardColumnOwner")

  @@map("users")
}

model Product {
  id                  String      @id @default(uuid())
  sku                 String
  name                String
  description         String?
  descriptionPt       String?
  components          String?
  componentsPt        String?
  sectors             String[]
  videoLinks          String[]    @default([])
  kind                ProductKind @default(COMPLETE_MODEL)
  weightKg            Decimal?    @db.Decimal(10, 3)
  priceBRL            Decimal?    @db.Decimal(12, 2)
  priceUSD            Decimal?    @db.Decimal(12, 2)
  priceUSDDistributor Decimal?    @db.Decimal(12, 2)
  priceEUR            Decimal?    @db.Decimal(12, 2)
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  updatedById String?
  updatedBy   User?   @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  media           ProductMedia[]
  brochures       ProductBrochure[]
  customizations  ProductCustomization[]
  quoteItems      QuoteItem[]

  @@map("products")
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType
  isPrimary Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("product_media")
}

model ProductBrochure {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_brochures")
}

model ProductCustomization {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  options     Json
  createdAt   DateTime @default(now())

  @@map("product_customizations")
}

/// Cliente do catálogo — serve tanto para pessoa física (cirurgião) quanto para
/// instituição ou distribuidor, e para qualquer país. Campos de endereço são
/// texto livre porque formato postal varia demais entre países; billTo/shipTo
/// guardam o bloco pronto que o pedido reaproveita.
model Client {
  id       String     @id @default(uuid())
  kind     ClientKind @default(INDIVIDUAL)
  prefix   ClientPrefix @default(NONE)
  name     String
  /// Instituição/hospital quando o cliente é uma pessoa
  institution String?
  email    String?
  phone    String?
  taxId    String?
  website  String?

  country String?
  state   String?
  city    String?
  /// Blocos completos reaproveitados no pedido (Invoice / Packing List)
  billToText String?
  shipToText String?

  /// Especialidades de interesse — casa com os setores do catálogo
  sectors String[] @default([])
  notes   String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  quotes Quote[]

  @@index([name])
  @@map("clients")
}

model Quote {
  id           String        @id @default(uuid())
  quoteNumber  String        @unique
  language     QuoteLanguage @default(PT)
  currency     Currency      @default(USD)
  priceTier    PriceTier     @default(FINAL)
  clientPrefix ClientPrefix  @default(NONE)
  /// Snapshot do nome no momento da emissão: o documento já enviado não pode
  /// mudar se o cadastro do cliente for renomeado depois.
  clientName   String
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  notes        String?
  freight      Decimal?      @db.Decimal(12, 2)
  discount     Decimal       @db.Decimal(12, 2) @default(0)
  subtotal     Decimal       @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  pdfUrl       String?
  xlsxUrl      String?
  createdAt    DateTime      @default(now())

  createdById String
  createdBy   User   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  items         QuoteItem[]
  orders        Order[]
  personalTasks PersonalTask[]

  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  sku         String
  description String
  quantity    Int
  /// Preço de catálogo na moeda/tabela do orçamento, congelado na emissão.
  /// Null quando o produto não tinha preço e o vendedor digitou um valor à mão.
  /// Quando difere de `unitPrice`, o documento ganha a coluna de preço especial.
  listPrice   Decimal? @db.Decimal(12, 2)
  /// Preço efetivamente cobrado — é ele que vai para o total e para o invoice.
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@map("quote_items")
}

model Order {
  id          String @id @default(uuid())
  orderNumber Int    @unique

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  purchaseOrder String?
  orderedByEmail String
  shipDate      DateTime?
  invoiceDate   DateTime  @default(now())

  billToText  String
  shipToText  String
  shipToNote  String?

  numberOfPackages String?
  netWeightKg      Decimal? @db.Decimal(10, 3)
  grossWeightKg    Decimal? @db.Decimal(10, 3)
  awbNumber        String?
  incoterms        String?

  // Number of physical boxes/cartons shipped — drives how many pages the
  // Packing List Box document gets (one per box).
  packageCount Int @default(1)
  // Which quote items (by index) and quantities go in each box, aligned by
  // array index with packageCount. Null/omitted means "everything in box 1"
  // (the pre-existing single-box behavior).
  boxAssignments Json?

  status OrderStatus @default(PENDING)

  prepaymentBy PrepaymentMethod @default(WIRE_TRANSFER)
  paypalFee    Decimal?         @db.Decimal(12, 2)

  nfNumber       String?
  nfDate         DateTime?
  nfDocumentUrl  String?
  awbDocumentUrl String?

  exchangeRate Decimal? @db.Decimal(10, 4)
  // Per unit weight (kg) for each quote item, aligned by array index — used to
  // fill in the export document's "KG Unit." column when the product itself
  // has no catalog weight. Kept on the order (not the product) since it's
  // filled in per-sale.
  itemWeightsKg Json?

  invoicePdfUrl        String?
  packingListPdfUrl    String?
  packingListBoxPdfUrl String?
  exportDocXlsxUrl     String?

  createdById String
  createdBy   User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  personalTasks PersonalTask[]

  @@map("orders")
}

model PersonalBoardColumn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("PersonalBoardColumnOwner", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  tasks PersonalTask[]

  @@map("personal_board_columns")
}

model PersonalTask {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation("PersonalTaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  title      String
  notes      String?
  clientName String?
  tags       String[]            @default([])
  dueDate    DateTime?
  columnId   String
  column     PersonalBoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  position   Int                 @default(0)
  quoteId    String?
  quote      Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("personal_tasks")
}
