// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientPrefix {
  NONE
  MR
  MS
}

enum MediaType {
  IMAGE
  DOCUMENT
}

enum QuoteLanguage {
  PT
  EN
  ES
}

enum ProductKind {
  COMPLETE_MODEL
  COMPONENT
}

enum PriceTier {
  FINAL
  DISTRIBUTOR
}

enum Currency {
  BRL
  USD
  EUR
}

enum PrepaymentMethod {
  PAYPAL
  WIRE_TRANSFER
}

enum OrderStatus {
  PENDING
  COMPLETED
}

model Sector {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("sectors")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(PENDING)
  active       Boolean       @default(true)
  phone        String?
  jobTitle     String?
  signatureUrl String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  productUpdates Product[] @relation("ProductUpdatedBy")
  quotes         Quote[]   @relation("QuoteCreatedBy")
  orders         Order[]   @relation("OrderCreatedBy")

  @@map("users")
}

model Product {
  id                  String      @id @default(uuid())
  sku                 String
  name                String
  description         String?
  components          String?
  sectors             String[]
  kind                ProductKind @default(COMPLETE_MODEL)
  weightKg            Decimal?    @db.Decimal(10, 3)
  priceBRL            Decimal?    @db.Decimal(12, 2)
  priceUSD            Decimal?    @db.Decimal(12, 2)
  priceUSDDistributor Decimal?    @db.Decimal(12, 2)
  priceEUR            Decimal?    @db.Decimal(12, 2)
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  updatedById String?
  updatedBy   User?   @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  media           ProductMedia[]
  customizations  ProductCustomization[]
  quoteItems      QuoteItem[]

  @@map("products")
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  type      MediaType
  isPrimary Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("product_media")
}

model ProductCustomization {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  options     Json
  createdAt   DateTime @default(now())

  @@map("product_customizations")
}

model Quote {
  id           String        @id @default(uuid())
  quoteNumber  String        @unique
  language     QuoteLanguage @default(PT)
  currency     Currency      @default(USD)
  priceTier    PriceTier     @default(FINAL)
  clientPrefix ClientPrefix  @default(NONE)
  clientName   String
  notes        String?
  freight      Decimal?      @db.Decimal(12, 2)
  discount     Decimal       @db.Decimal(12, 2) @default(0)
  subtotal     Decimal       @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  pdfUrl       String?
  xlsxUrl      String?
  createdAt    DateTime      @default(now())

  createdById String
  createdBy   User   @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  items  QuoteItem[]
  orders Order[]

  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  sku         String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@map("quote_items")
}

model Order {
  id          String @id @default(uuid())
  orderNumber Int    @unique

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  purchaseOrder String?
  orderedByEmail String
  shipDate      DateTime?
  invoiceDate   DateTime  @default(now())

  billToText  String
  shipToText  String
  shipToNote  String?

  numberOfPackages String?
  netWeightKg      Decimal? @db.Decimal(10, 3)
  grossWeightKg    Decimal? @db.Decimal(10, 3)
  awbNumber        String?
  incoterms        String?

  // Number of physical boxes/cartons shipped — drives how many pages the
  // Packing List Box document gets (one per box).
  packageCount Int @default(1)
  // Which quote items (by index) and quantities go in each box, aligned by
  // array index with packageCount. Null/omitted means "everything in box 1"
  // (the pre-existing single-box behavior).
  boxAssignments Json?

  status OrderStatus @default(PENDING)

  prepaymentBy PrepaymentMethod @default(WIRE_TRANSFER)
  paypalFee    Decimal?         @db.Decimal(12, 2)

  nfNumber       String?
  nfDate         DateTime?
  nfDocumentUrl  String?
  awbDocumentUrl String?

  exchangeRate Decimal? @db.Decimal(10, 4)
  // Per unit weight (kg) for each quote item, aligned by array index — used to
  // fill in the export document's "KG Unit." column when the product itself
  // has no catalog weight. Kept on the order (not the product) since it's
  // filled in per-sale.
  itemWeightsKg Json?

  invoicePdfUrl        String?
  packingListPdfUrl    String?
  packingListBoxPdfUrl String?
  exportDocXlsxUrl     String?

  createdById String
  createdBy   User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("orders")
}
