# Copie para .env.prod e preencha. Esse arquivo NÃO vai para o git.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ─── Endereço e protocolo ─────────────────────────────────────────────────────
# MODO HTTP (padrão) — sistema interno, acesso pela rede/VPN, todo mundo confiável.
#   Suba com:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
PUBLIC_URL=http://192.168.1.50:8080
HTTP_PORT=8080
COOKIE_SECURE=false
TRUST_PROXY=1

# MODO HTTPS (opcional) — para ligar, troque as quatro linhas acima por estas,
# preencha SITE_ADDRESS, e suba com  --profile https :
#   PUBLIC_URL=https://192.168.1.50
#   SITE_ADDRESS=192.168.1.50
#   WEB_BIND=127.0.0.1
#   CADDY_HTTP_PORT=80
#   HTTPS_PORT=443
#   COOKIE_SECURE=true
#   TRUST_PROXY=2

# ─── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=prodelphus
POSTGRES_DB=prodelphusplus
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── Segredos JWT ─────────────────────────────────────────────────────────────
# 32+ caracteres cada, sem palavras de exemplo. A API se recusa a subir sem isso.
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Primeira conta de admin ──────────────────────────────────────────────────
# Usada só na primeira vez, pelo `npm run prisma:seed`. Mínimo 10 caracteres.
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@prodelphus.com.br
ADMIN_SEED_PASSWORD=

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
