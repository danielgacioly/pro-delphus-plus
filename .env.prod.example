# Copie para .env.prod e preencha. Esse arquivo NÃO vai para o git.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ─── Endereço ─────────────────────────────────────────────────────────────────
# O sistema fica na rede interna; quem está fora entra pela VPN. Use o IP ou o
# nome interno do servidor. O Caddy emite um certificado da própria CA interna
# (não depende de internet) — a raiz precisa ser instalada nas máquinas dos
# usuários uma vez. Ver README, seção HTTPS.
SITE_ADDRESS=192.168.1.50
# Como o NAVEGADOR enxerga o sistema. Vira o CORS_ORIGIN da API.
# Precisa casar com SITE_ADDRESS, incluindo a porta se não for 443.
PUBLIC_URL=https://192.168.1.50
# Portas publicadas pelo Caddy no servidor. A 80 só faz redirecionar para HTTPS.
HTTP_PORT=80
HTTPS_PORT=443

# ─── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=prodelphus
POSTGRES_DB=prodelphusplus
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── Segredos JWT ─────────────────────────────────────────────────────────────
# 32+ caracteres cada, sem palavras de exemplo. A API se recusa a subir sem isso.
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Primeira conta de admin ──────────────────────────────────────────────────
# Usada só na primeira vez, pelo `npm run prisma:seed`. Mínimo 10 caracteres.
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@prodelphus.com.br
ADMIN_SEED_PASSWORD=

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
