# Copie para .env.prod e preencha. Esse arquivo NÃO vai para o git.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ─── Endereço ─────────────────────────────────────────────────────────────────
# HTTP puro — sistema interno, acesso pela rede/VPN, todo mundo confiável.
# PUBLIC_URL é como o navegador enxerga o sistema; vira o CORS_ORIGIN da API.
PUBLIC_URL=http://192.168.1.50:8080
HTTP_PORT=8080

# ─── Onde os dados ficam guardados ─────────────────────────────────────────────
# Aponte para um disco/partição SEPARADO do sistema operacional — sem isso, o
# banco de dados e os arquivos enviados crescem dentro de /var/lib/docker e
# podem lotar a partição do próprio SO. Ver README, seção "Onde os dados ficam
# guardados", para o passo de criar as pastas antes do primeiro `up`.
DATA_ROOT=/data/prodelphusplus

# ─── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=prodelphus
POSTGRES_DB=prodelphusplus
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── Segredos JWT ─────────────────────────────────────────────────────────────
# 32+ caracteres cada, sem palavras de exemplo. A API se recusa a subir sem isso.
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Primeira conta de admin ──────────────────────────────────────────────────
# Usada só na primeira vez, pelo `npm run prisma:seed`. Mínimo 10 caracteres.
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@prodelphus.com.br
ADMIN_SEED_PASSWORD=

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_KEEP_COUNT=2
BACKUP_INTERVAL_SECONDS=86400
