{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "import/no-unassigned-import": "off",
    "oxc/no-map-spread": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/api/generated/**",
    "apps/web/dist/**"
  ]
}
